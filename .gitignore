# 忽略图片文件夹中的内容
back_end/dataset_split/*
back_end/images/*
!back_end/static/.gitkeep

# 忽略YOLO模型文件
back_end/yolo11n.pt
email_test.py

# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 测试文件和数据库
back_end/test_*.db
back_end/test_*.html
back_end/test_*.py
back_end/report_*.html

# 忽略Node.js相关文件
front_end/node_modules/
front_end/dist/
front_end/npm-debug.log*
front_end/yarn-debug.log*
front_end/yarn-error.log*
front_end/node-v18.20.4-x64.msi
front_end/nvm-setup.exe

# 但保留空文件夹结构
!back_end/dataset_split/.gitkeep
!back_end/images/.gitkeep
!front_end/node_modules/.gitkeep
!front_end/dist/.gitkeep

# 忽略FILES文件夹及内容
FILES/

# 忽略检测结果文件
back_end/static/results/images/*.png
back_end/static/results/thumbnails/*.png
back_end/static/results/jsons/*/
!back_end/static/results/images/.gitkeep
!back_end/static/results/jsons/.gitkeep
!back_end/static/results/thumbnails/.gitkeep

# 忽略数据库文件
back_end/database.db

# 忽略除readme.md外的所有markdown文件
*.md
!readme.md
!README.md
!daily/*.md